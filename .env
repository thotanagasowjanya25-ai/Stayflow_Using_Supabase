# Copy this file to .env. NEVER commit .env.
# Generate each secret with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-long-random-value
JWT_SECRET=replace-with-a-different-long-random-value

# Supabase > Project Settings > API 
SUPABASE_URL= 
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= 
# Supabase > Connect > Session pooler is recommended for IPv4 networks.
# URL-encode reserved characters in the DB password (e.g. @ => %40, # => %23, $ => %24).
#python -c "import urllib.parse; print(urllib.parse.quote(input('Enter password: '), safe=''))"
DATABASE_URL=


# SMTP / Gmail App Password configuration
# For Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
#   myaccount.google.com/apppasswords
SMTP_APP_PASSWORD=
MAIL_FROM=


# Auth behavior
# Guest signup is performed server-side with the Supabase Admin API and is
# auto-confirmed. The service/secret key must therefore remain SERVER ONLY.

# Optional deterministic demo logins used by seed_demo_data.py.
# Change these before sharing/deploying the project.
DEMO_ADMIN_PASSWORD=123456789
DEMO_MANAGER_PASSWORD=123456789
DEMO_GUEST_PASSWORD=123456789
